# ---------------------------------------------------------------------------
# Foot Predict - variables d'environnement (backend + automatisation)
#
# Copiez ce fichier en « .env » à la racine du projet et renseignez les valeurs.
# Le fichier .env est ignoré par git (voir .gitignore) : ne commitez jamais
# votre clé API.
# ---------------------------------------------------------------------------

# Clé The Odds API (https://the-odds-api.com/) - plan gratuit : 500 requêtes/mois.
# Sans clé, le pipeline se rabat sur fixtures.csv de Football-Data.co.uk.
ODDS_API_KEY=

# Régions des bookmakers interrogés (eu = Europe, contenant Pinnacle).
ODDS_API_REGIONS=eu

# Bookmakers de référence, par ordre de préférence. À défaut, moyenne du marché.
ODDS_REFERENCE_BOOKMAKERS=pinnacle,bet365

# Fenêtres de recherche des affiches à venir (en jours).
ODDS_WINDOW_DAYS=7
ODDS_BREAK_WINDOW_END_DAYS=21

# Profondeur du calendrier libre OpenFootball (mode sans clé API).
FIXTURES_HORIZON_DAYS=21

# ---------------------------------------------------------------------------
# Contexte externe OPTIONNEL (effectifs, blessures, compositions, notes joueurs)
#
# 1) API-Football (api-sports.io) : effectifs + blessures.
#    Plan gratuit : effectifs OK ; blessures limitées aux saisons 2022-2024.
# 2) Highlightly (soccer.highlightly.net) : compositions + notes des joueurs.
#
# Sans clé, l'application fonctionne normalement (seule la forme interne est
# affichée) et l'interface indique que la source n'est pas configurée.
# ---------------------------------------------------------------------------
API_FOOTBALL_KEY=
# Vide = détection automatique ("direct" ou "rapidapi")
API_FOOTBALL_MODE=
# Highlightly : compositions + notes des joueurs
HIGHLIGHTLY_API_KEY=
# Football-Data.org : effectifs structurés + classement
FOOTBALL_DATA_KEY=

# Fuseau d'affichage des coups d'envoi (l'API renvoie de l'UTC).
DISPLAY_TIMEZONE=Europe/Paris

# Origines autorisées par CORS (séparées par des virgules).
# En production : ALLOWED_ORIGINS=https://votre-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
