# Variables d'environnement du frontend Next.js
# Copiez ce fichier en .env.local (développement) ou définissez les variables
# dans l'interface Render (déploiement production).

# URL du backend FastAPI (Render, Railway, etc.)
# Exemple : https://foot-predict-api.onrender.com
NEXT_PUBLIC_API_URL=

# Fuseau horaire d'affichage des coups d'envoi
DISPLAY_TIMEZONE=Europe/Paris
